      "versionNonce": 1200549979,
      "isDeleted": false,
      "boundElements": null,
      "updated": 1793159740858,
      "link": null,
      "locked": false,
      "text": "calculateQuote is already pure.\n\nIt shares app.js with rendering, storage and\nexport.\n\nThe same calculator feeds live totals, saved\nquotes, scenarios and the proposal.\n\nMove its boundary; preserve its callers.",
      "fontSize": 27,
      "fontFamily": 1,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "calculateQuote is already pure.\n\nIt shares app.js with rendering, storage and\nexport.\n\nThe same calculator feeds live totals, saved\nquotes, scenarios and the proposal.\n\nMove its boundary; preserve its callers.",
      "autoResize": true,
      "lineHeight": 1.25
    },
