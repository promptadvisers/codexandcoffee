      "boundElements": null,
      "updated": 1793159741106,
      "link": null,
      "locked": false,
      "text": "Money is numeric cents.\nKeep the exact returned keys.\nKeep row order and duplicate IDs.\nDo not mutate the input.\nTax uses net fees.\nDeposit uses total including tax.\n\nUnsupported null inputs still throw TypeError.",
      "fontSize": 27,
      "fontFamily": 1,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Money is numeric cents.\nKeep the exact returned keys.\nKeep row order and duplicate IDs.\nDo not mutate the input.\nTax uses net fees.\nDeposit uses total including tax.\n\nUnsupported null inputs still throw TypeError.",
      "autoResize": true,
      "lineHeight": 1.25
    },
