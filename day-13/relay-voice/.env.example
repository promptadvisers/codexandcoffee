# Copy to ~/.config/relay-voice/providers.env, outside this repository.
GOOGLE_API_KEY=
FIRECRAWL_API_KEY=
# Optional, only if gws is not on the standard package-manager PATH:
# RELAY_GWS_BIN=/absolute/path/to/gws
# Optional explicit Google CLI profiles:
# RELAY_GWS_CONFIG_PRIMARY=/absolute/path/to/private/google-config
# RELAY_GWS_CONFIG_WORK=/absolute/path/to/private/work-config
# RELAY_GWS_CONFIG_PERSONAL=/absolute/path/to/private/personal-config
