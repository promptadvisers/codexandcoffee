ontainerId": null, "originalText": "Keep the first version local, with fake clients and no login or email\nconnection. I want to review every draft before anything is sent.", "autoResize": true, "lineHeight": 1.25, "created": null, "labelPosition": null, "baseFontSize": null}, {"id": "6a2074ff10734a688416", "type": "arrow", "x": 4439.5, "y": 1233, "width": 139, "height": 0, "angle": 0, "strokeColor": "#AC6154", "backgroundColor": "transparent", "fillStyle": "solid", "strokeWidth": 2, "strokeStyle": "solid", "roughness": 1, "opacity": 100, "groupIds": [], "frameId": "03df5d6985634b348d8e", "index": "aTl", "roundness": null, "seed": 695073286, "version": 21, "versionNonce": 1377229723, "isDeleted": false, "boundElements": [], "updated": 1793228164610, "link": null, "locked": false, "points": [[0, 0], [-139, 0]], "lastCommittedPoint": null, "startBinding": null, "endBinding": null, "startArrowhead": null, "endArrowhead": "arrow", "elbowed": false, "created": null}, {"id": "d7c2de3eb56b470cbc2d", "type": "text", "x": 4480, "y": 1149, "width": 378.35986328125, "height": 45, "angle": 0, "strokeColor": "#AC6154", "backgroundColor": "transparent", "fillStyle": "solid", "strokeWidth": 2, "strokeStyle": "solid", "roughness": 1, "opacity": 100, "groupIds": [], "frameId": "03df5d6985634b348d8e", "index": "aTnV", "roundness": null, "seed": 1745555802, "version": 21, "versionNonce": 604667797, "isDeleted": false, "boundElements": [], "updated": 1793228164610, "link": null, "locked": false, "text": "where should it stop?", "fontSize": 36, "fontFamily": 5, "textAlign": "left", "verticalAlign": "top", "containerId": null, "originalText": "where should it stop?", "autoResize": true, "lineHeight": 1.25, "created": null, "labelPosition": null, "baseFontSize": null}, {"id": "b2692af7cbbf42bca2ca", "type": "text", "x": 4480, "y": 1223, "width": 537.05078125, "height": 72.5, "angle": 0, "strokeColor": "#213044", "backgroundColor": "transparent", "fillStyle": "solid", "strokeWidth": 2, "strokeStyle": "solid", "roughness": 1, "opacity": 100, "groupIds": [], "frameId": "03df5d6985634b348d8e", "index": "aTpV", "roundness": null, "seed": 1055705414, "version": 21, "versionNonce": 1468969019, "isDeleted": false, "boundElements": [], "updated": 1793228164610, "link": null, "locked": false, "text": "Local data and draft-only replies keep\nthe first version manageable.", "fontSize": 29, "fontFamily": 5, "textAlign": "left", "verticalAlign": "top", "containerId": null, "originalText": "Local data and draft-only replies keep\nthe first version manageable.", "autoResize": true, "lineHeight": 1.25, "created": null, "labelPosition": null, "baseFontSize": null}, {"id": "21b78e44246e4cf99ec0", "type": "rectangle", "x": 2850, "y": 1363, "width": 1415, "height": 205, "angle": 0, "strokeColor": "#327D6B", "backgroundColor": "#E5F4EF", "fillStyle": "solid", "strokeWidth": 1.5, "strokeStyle": "solid", "roughness": 1, "opacity": 100, "groupIds": [], "frameId": "03df5d6985634b348d8e", "index": "aTr", "roundness": {"type": 3}, "seed": 169072154, "version": 21, "versionNonce": 840942837, "isDeleted": false, "boundElements": [], "updated": 1793228164610, "link": null, "locked": false, "created": null}, {"id": "d2a9a5cd29ba46a7ba2c", "type": "text", "x": 2880, "y": 1386, "width": 1155.3385009765625, "height": 116.25, "angle": 0, "strokeColor": "#213044", "backgroundColor": "transparent", "fillStyle": "solid", "strokeWidth": 2, "strokeStyle": "solid", "roughness": 1, "opacity": 100, "groupIds": [], "frameId": "03df5d6985634b348d8e", "index": "aTt", "roundness": null, "seed": 844083334, "version": 21, "versionNonce": 1415770331, "isDeleted": false, "boundElements": [], "updated": 1793228164610, "link": null, "locked": false, "text": "Before you build anything, show me a short plan: what the page does, a few\nsmall build steps, and how we would check it. Point out any assumption that\ncould change the plan.", "fontSize": 31, "fontFamily": 5, "textAlign": "left", "verticalAlign":